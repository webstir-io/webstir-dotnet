{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "dotnet",
            "task": "build ./CLI/CLI.csproj",
            "file": "./CLI/CLI.csproj",
            "group": "build",
            "problemMatcher": [],
            "label": "build"
        },
		{
			"label": "check:docker",
			"type": "shell",
			"command": "docker",
			"args": ["info"],
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			"label": "format:verify (style+analyzers)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"format",
				"--verify-no-changes",
				"--no-restore"
			],
			"problemMatcher": []
		},
		{
			"label": "format:verify:strict (include suggestions)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"format",
				"--verify-no-changes",
				"--no-restore",
				"--severity",
				"info"
			],
			"problemMatcher": []
		},
		{
			"label": "format:fix",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"format",
				"--no-restore"
			],
			"problemMatcher": []
		},
		{
			"label": "setup:framework-testing npm install",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"options": {
				"cwd": "${workspaceFolder}/framework/testing"
			},
			"runOptions": {
				"runOn": "folderOpen"
			},
			"problemMatcher": []
		}
	]
}
